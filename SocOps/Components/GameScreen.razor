@using SocOps.Models

<div class="flex flex-col min-h-full bg-princess-background">
    <!-- Header -->
    <header class="flex items-center justify-between p-3 bg-gradient-princess-soft border-b border-princess-primary/20 shadow-princess">
        <button
            @onclick="OnReset"
            class="text-princess-primary text-sm px-3 py-1.5 rounded-lg border border-princess-primary/30 hover:bg-princess-primary/10 transition-colors duration-200">
            ← Back
        </button>
        <h1 class="font-playfair font-bold text-gradient-princess text-xl">Princess Bingo</h1>
        <div class="w-16"></div>
    </header>

    <!-- Instructions -->
    <p class="text-center text-princess-secondary text-sm py-2 px-4 font-medium">
        ✨ Tap a square when you find someone who matches it
    </p>

    <!-- Bingo indicator -->
    @if (HasBingo)
    {
        <div class="bg-princess-winning text-white text-center py-2 font-bold text-sm shadow-princess animate-sparkle">
            👑 BINGO! You got a line! 👑
        </div>
    }

    <!-- Board -->
    <div class="flex-1 flex items-center justify-center p-3">
        <BingoBoard
            Board="@Board"
            WinningSquareIds="@WinningSquareIds"
            OnSquareClick="@OnSquareClick" />
    </div>
</div>

@code {
    [Parameter]
    public List<BingoSquareData> Board { get; set; } = new();

    [Parameter]
    public HashSet<int> WinningSquareIds { get; set; } = new();

    [Parameter]
    public bool HasBingo { get; set; }

    [Parameter]
    public EventCallback<int> OnSquareClick { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }
}
