<div class="flex flex-col items-center justify-center min-h-full p-6 bg-princess-background">
    <div class="text-center max-w-sm">
        <h1 class="text-5xl font-playfair font-bold text-gradient-princess mb-2 animate-float">Soc Ops</h1>
        <p class="text-lg text-princess-secondary mb-8 font-semibold">Princess Bingo</p>

        <div class="bg-gradient-princess-soft rounded-2xl p-6 shadow-princess border border-princess-primary/20 mb-8">
            <h2 class="font-playfair font-semibold text-princess-primary mb-3">How to Play</h2>
            <ul class="text-left text-gray-700 text-sm space-y-2">
                <li>• ✨ Find people who match the questions</li>
                <li>• 💫 Tap a square when you find a match</li>
                <li>• 👑 Get 5 in a row to win!</li>
            </ul>
        </div>

        <button
            @onclick="OnStart"
            class="w-full bg-gradient-princess text-white font-bold py-4 px-8 rounded-2xl text-lg shadow-princess hover:shadow-princess-lg transition-all duration-300 transform hover:scale-105">
            Start Game ✨
        </button>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnStart { get; set; }
}
