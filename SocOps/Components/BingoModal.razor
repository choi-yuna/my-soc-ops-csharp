<div class="fixed inset-0 bg-black/30 flex items-center justify-center p-4 z-50">
    <div class="bg-gradient-princess rounded-2xl p-8 max-w-sm w-full text-center shadow-princess-lg animate-float border-4 border-princess-winning">
        <div class="text-6xl mb-4 animate-sparkle">👑</div>
        <h2 class="text-4xl font-playfair font-bold text-white mb-2 drop-shadow-lg">BINGO!</h2>
        <p class="text-white/90 mb-8 font-medium">You are the Princess of Bingo! ✨</p>

        <button
            @onclick="OnDismiss"
            class="w-full bg-princess-winning text-white font-bold py-4 px-6 rounded-xl shadow-princess hover:shadow-princess-lg transition-all duration-300 transform hover:scale-105">
            Keep Playing 👑
        </button>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnDismiss { get; set; }
}
