@using SocOps.Models

<button
    @onclick="OnClick"
    disabled="@Square.IsFreeSpace"
    class="@GetCssClasses()"
    aria-pressed="@Square.IsMarked"
    aria-label="@(Square.IsFreeSpace ? "Free space" : Square.Text)">
    <span class="wrap-break-word hyphens-auto">@Square.Text</span>
    @if (Square.IsMarked && !Square.IsFreeSpace)
    {
        <span class="absolute top-0.5 right-0.5 text-princess-primary text-xs animate-sparkle">✨</span>
    }
    @if (Square.IsFreeSpace)
    {
        <span class="absolute top-0.5 right-0.5 text-princess-winning text-xs">👑</span>
    }
</button>

@code {
    [Parameter]
    public BingoSquareData Square { get; set; } = null!;

    [Parameter]
    public bool IsWinning { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    private string GetCssClasses()
    {
        var baseClasses = "relative flex items-center justify-center p-1 text-center border-2 rounded-xl transition-all duration-300 select-none min-h-[60px] text-xs leading-tight shadow-sm hover:shadow-princess transform hover:scale-105";

        var stateClasses = Square.IsMarked
            ? IsWinning
                ? "bg-princess-winning border-princess-winning text-white font-bold shadow-princess"
                : "bg-princess-secondary/10 border-princess-secondary text-princess-secondary"
            : "bg-white border-princess-primary/30 text-gray-700 hover:border-princess-primary/60 hover:bg-princess-background-light";

        var freeSpaceClasses = Square.IsFreeSpace ? "bg-gradient-princess border-princess-primary text-white font-bold text-sm shadow-princess" : "";

        return $"{baseClasses} {stateClasses} {freeSpaceClasses}";
    }
}
